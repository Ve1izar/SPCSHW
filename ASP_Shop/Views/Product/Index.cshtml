@model IEnumerable<ProductModel>
@{
    ViewData["Title"] = "Товари";
}
<div class="container">
    <h2 class="text-center mb-4">Список товарів</h2>

    <div class="table-responsive">
        <table class="table table-striped text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>К-сть</th>
                    <th>Category</th>
                    <th>Image</th>
                    <th>
                        <a class="text-white" asp-controller="Product" asp-action="Create" title="Додати товар">
                            <i class="bi bi-plus-circle-fill fs-5"></i>
                        </a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td>@product.Price.ToString("#.##") ₴</td>
                        <td>
                            <span class="badge @(product.Amount > 0 ? "bg-success" : "bg-danger")">@product.Amount</span>
                        </td>
                        <td>@(product.Category != null ? product.Category.Name : "Без категорії")</td>
                        <td>
                            <img class="image-scale" height="50" src="@(product.Image != null && product.Image.StartsWith("http") ? product.Image : $"/images/{(string.IsNullOrWhiteSpace(product.Image) ? "noimage.png" : $"products/{product.Image}")}")" alt="@product.Name">
                        </td>
                        <td>
                            <a asp-route-id="@product.Id" asp-controller="Product" asp-action="Edit" class="mx-2">
                                <i class="bi bi-pencil-square text-warning fs-5"></i>
                            </a>
                            <a asp-route-id="@product.Id" asp-controller="Product" asp-action="Delete" onclick="return confirm('Ви впевнені, що хочете видалити цей товар?');">
                                <i class="bi bi-trash-fill text-danger fs-5"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>