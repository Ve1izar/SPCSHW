<Window x:Class="Theme_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пошук слова у файлах" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Директорія:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="DirectoryTextBox" Grid.Column="1" Height="25" VerticalContentAlignment="Center"/>
            <Button Content="Обрати..." Grid.Column="2" Width="70" Margin="5,0,0,0" Click="BrowseButton_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Слово для пошуку:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchWordTextBox" Grid.Column="1" Height="25" VerticalContentAlignment="Center"/>
            <Button x:Name="SearchButton" Content="Пошук" Grid.Column="2" Width="70" Margin="5,0,0,0" Click="SearchButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="StatusTextBlock" Text="Очікування..." Margin="0,0,0,5" Foreground="Gray"/>
            <ProgressBar x:Name="SearchProgressBar" Height="20" Minimum="0" Maximum="100"/>
        </StackPanel>

        <ListView x:Name="ResultsListView" Grid.Row="3">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Назва файлу" Width="150" DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="Кількість входжень" Width="120" DisplayMemberBinding="{Binding Count}"/>
                    <GridViewColumn Header="Шлях до файлу" Width="450" DisplayMemberBinding="{Binding FilePath}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="SummaryTextBlock" Grid.Row="4" Margin="0,5,0,0" FontWeight="Bold"/>
    </Grid>
</Window>